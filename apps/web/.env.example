# Firebase web config (get values: Firebase console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only (NEVER prefix with NEXT_PUBLIC_): Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on ONE line. Powers local `npm run dev` API routes AND Vercel/hosting env.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Server only: shared Telegram bot. BotFather → /newbot → token. One bot serves
# all users; each user pastes their chat ID in Settings. Add to .env.local too.
TELEGRAM_BOT_TOKEN=
# Optional webhook guard: setWebhook ...&secret_token=<this> and Telegram sends
# it back as x-telegram-bot-api-secret-token on every update.
TELEGRAM_WEBHOOK_SECRET=
