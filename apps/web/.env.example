# Firebase web config (get values: Firebase console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only (NEVER prefix with NEXT_PUBLIC_): Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on ONE line. Powers local `npm run dev` API routes AND Vercel/hosting env.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Server only: master key for AES-256-GCM settings encryption. REQUIRED —
# the app refuses to encrypt without it (fail-closed, no fallback).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Server only: override the Groq draft model without a deploy.
# Defaults to openai/gpt-oss-120b in code. Useful when Groq retires IDs.
GROQ_MODEL=

# Server only: shared Telegram bot. BotFather → /newbot → token. One bot serves
# all users; each user pastes their chat ID in Settings. Add to .env.local too.
TELEGRAM_BOT_TOKEN=
# Optional webhook guard: setWebhook ...&secret_token=<this> and Telegram sends
# it back as x-telegram-bot-api-secret-token on every update.
TELEGRAM_WEBHOOK_SECRET=

# Server only: shared secret for /api/cron/morning. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET` automatically when set in project env.
# Generate: any long random string. Manual trigger: curl -H "Authorization: Bearer <secret>".
CRON_SECRET=

# Server only: gate for /api/diag (defaults to CRON_SECRET when unset).
DIAG_SECRET=

# Trigger.dev: dev secret key (dashboard → project → API keys, development).
# Paste into apps/web/.env.local (NEVER commit). Prod uses dashboard env vars.
TRIGGER_SECRET_KEY=
